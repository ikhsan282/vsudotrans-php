# Database Configuration (kosong/biarkan default untuk XAMPP lokal)
DB_HOST="localhost"
DB_USER="root"
DB_PASS=""
DB_NAME="vsudotrans"

# Opsional: override base URL pada server/reverse proxy tertentu
# VSUDO_APP_URL="https://erp.domainanda.com"

# Azure Blob Storage Configuration
BLOB_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=vsudotransstorage;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net"
BLOB_STORAGE_CONTAINER="vsudotrans"

# AI Assistant & Isi Cepat (9router, OpenAI-compatible)
VSUDO_AI_BASE_URL="http://localhost:20128/v1"
VSUDO_AI_API_KEY=""
VSUDO_AI_MODEL="ikhsan-reason"
VSUDO_AI_CHAT_MODEL=""

# AI Cadangan (DeepSeek API, aktif otomatis jika 9router mati/timeout)
VSUDO_AI_FALLBACK_BASE_URL="https://api.deepseek.com/v1"
VSUDO_AI_FALLBACK_API_KEY=""
VSUDO_AI_FALLBACK_MODEL="deepseek-flash"
VSUDO_AI_FALLBACK_CHAT_MODEL=""
