# VSudoTrans — keamanan & setting shared hosting (cPanel/Apache)
Options -Indexes
ServerSignature Off

# PHP settings for shared hosting
<IfModule mod_php8.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 6M
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 6M
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Blokir file sensitif (schema, log, markdown, dokumen)
<FilesMatch "\.(sql|log|env|md|sh|ini|bak|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blokir akses langsung ke direktori sensitif
RedirectMatch 403 ^.*/(config|includes|tests)/.*$
RedirectMatch 403 ^.*/database/.*$

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir hidden files (.git, .env, dll)
    RewriteRule (^|/)\. - [F,L]
</IfModule>